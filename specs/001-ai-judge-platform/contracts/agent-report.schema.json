{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibehack.local/contracts/agent-report.schema.json",
  "title": "AgentDocument",
  "description": "Документы, которые роли сдают инструментами плагина ai-judge (зона C): report_rubric, report_ux_metrics, report_scores, report_flag, report_claims. Плагин проверяет документ по этой схеме ДО сохранения и при ошибке возвращает модели текст ошибки, чтобы она исправила вызов в том же запуске. Принятый документ лежит в runs/<run_id>/reports/<role>.json (для rubric и design-метрик — projects/<project_id>/…); backend читает файл после завершения запуска.",
  "oneOf": [
    {
      "$ref": "#/$defs/scores_document"
    },
    {
      "$ref": "#/$defs/rubric_document"
    },
    {
      "$ref": "#/$defs/ux_metrics_document"
    },
    {
      "$ref": "#/$defs/inventory_patch_document"
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "file",
            "slide",
            "video",
            "screenshot",
            "url",
            "claim",
            "commit",
            "search"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "file: путь:строки (api/routes.py:40-88); slide: презентация#номер (deck.pdf#4); video: файл@чч:мм:сс; screenshot: имя файла в runs/<run_id>/artifacts/; url: адрес; claim: claim_id; commit: sha; search: поисковый запрос."
        },
        "quote": {
          "type": "string",
          "maxLength": 500,
          "description": "Короткая цитата, подтверждающая наблюдение."
        }
      }
    },
    "score": {
      "type": "object",
      "required": [
        "criterion_id",
        "status",
        "justification",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "scored",
            "no_data"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "max_score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 10
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "no_data_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "scored"
              }
            }
          },
          "then": {
            "required": [
              "score",
              "evidence"
            ],
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "no_data"
              }
            }
          },
          "then": {
            "required": [
              "no_data_reason"
            ]
          }
        }
      ]
    },
    "flag": {
      "type": "object",
      "required": [
        "type",
        "confidence",
        "note",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "plagiarism",
            "pre_start_project",
            "claim_mismatch",
            "prompt_injection",
            "incomplete_materials",
            "agent_failure",
            "secret_exposed"
          ]
        },
        "criterion_id": {
          "type": "string",
          "description": "Если флаг относится к конкретному критерию."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "related_submission_id": {
          "type": "string"
        },
        "related_url": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "text",
        "source_ref",
        "verdict",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_ref": {
          "$ref": "#/$defs/evidence"
        },
        "verdict": {
          "enum": [
            "confirmed",
            "not_found",
            "contradicted"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "scores_document": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "submission_id",
        "role",
        "rubric_version",
        "scores",
        "flags"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "kind": {
          "const": "scores"
        },
        "run_id": {
          "type": "string"
        },
        "submission_id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "code",
            "business",
            "design",
            "critic-uniqueness",
            "critic-honesty"
          ]
        },
        "rubric_version": {
          "type": "integer",
          "minimum": 1
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/score"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flag"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "description": "Только critic-honesty."
        },
        "experts": {
          "type": "array",
          "description": "Только business: профильные эксперты, которых поднял бизнес-эксперт, и их оценки (медиана идёт в scores).",
          "items": {
            "type": "object",
            "required": [
              "name",
              "domain"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "scores": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/score"
                }
              }
            }
          }
        },
        "summary": {
          "type": "string",
          "maxLength": 3000,
          "description": "Короткое резюме роли для модального окна."
        }
      }
    },
    "rubric_document": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "criteria"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "kind": {
          "const": "rubric_draft"
        },
        "project_id": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "weight",
              "max_score",
              "agent",
              "source_ref"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max_score": {
                "type": "number",
                "exclusiveMinimum": 0,
                "default": 10
              },
              "agent": {
                "enum": [
                  "code",
                  "business",
                  "design",
                  "critic-uniqueness",
                  "critic-honesty",
                  "human"
                ]
              },
              "anchors": {
                "type": "array",
                "description": "Якоря шкалы: что значит низкий, средний и высокий балл. Нужны против разброса оценок (NFR-006).",
                "items": {
                  "type": "object",
                  "required": [
                    "score",
                    "meaning"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "score": {
                      "type": "number"
                    },
                    "meaning": {
                      "type": "string"
                    }
                  }
                }
              },
              "source_ref": {
                "type": "string",
                "description": "Откуда взят критерий: материал вводных и место."
              }
            }
          }
        },
        "weights_were_missing": {
          "type": "boolean",
          "description": "Веса в вводных не заданы, поставлены равные."
        }
      }
    },
    "ux_metrics_document": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "project_id",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "kind": {
          "const": "ux_metrics"
        },
        "project_id": {
          "type": "string"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "how_to_measure",
              "good_looks_like"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "how_to_measure": {
                "type": "string"
              },
              "good_looks_like": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "inventory_patch_document": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "submission_id",
        "updates"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "kind": {
          "const": "inventory_patch"
        },
        "run_id": {
          "type": "string"
        },
        "submission_id": {
          "type": "string"
        },
        "updates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "material_id",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "material_id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "repository",
                  "host",
                  "presentation",
                  "screencast",
                  "archive",
                  "code_file",
                  "document",
                  "image",
                  "metrics_row",
                  "other"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  }
}
