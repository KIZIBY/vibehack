# Окружение платформы AI-судья. Скопируй в .env (он в .gitignore) и заполни пустые значения.
# Секреты только в .env или менеджере секретов — в этот файл их не вписывать.
# Подхватывается scripts/dev.sh; для запуска вне dev.sh — выполни в shell: set -a; . ./.env; set +a

# Логин демо-пользователя (вход в платформу).
JUDGE_DEMO_USER=demo
# Пароль демо-пользователя. Обязателен, без значения по умолчанию.
JUDGE_DEMO_PASSWORD=
# Корень общего каталога материалов: backend пишет, Hermes читает (в контейнере — /opt/data/workspaces).
# Относительный путь считают от корня репозитория (dev.sh, hermes/deploy.sh); для голого docker compose задай абсолютный.
JUDGE_DATA_DIR=./data
# Секрет подписи сессий (случайная строка 32+ байт). Обязателен, без значения по умолчанию.
JUDGE_SESSION_SECRET=
# Строка подключения к БД (SQLite на демо, затем Postgres). Логин:пароль в URL не вписывать — только через .env.
JUDGE_DATABASE_URL=sqlite:///./judge.db
# Адрес API шлюза Hermes (по умолчанию loopback; fake-шлюз dev.sh слушает тот же порт).
HERMES_API_URL=http://127.0.0.1:8642
# Ключ API шлюза Hermes (Authorization: Bearer). Тот же, что в hermes/.env. Без значения по умолчанию.
API_SERVER_KEY=
# Сколько работ проверяется параллельно (остальные ждут в очереди).
JUDGE_MAX_PARALLEL_SUBMISSIONS=5
# Через сколько дней удаляются материалы и отчёты завершённых работ.
JUDGE_RETENTION_DAYS=30
