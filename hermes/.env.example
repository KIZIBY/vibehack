# Справочник переменных Hermes. Настоящий файл живёт на сервере: ~/.hermes/.env
# (его пишет мастер `docker compose run --rm hermes setup`). В репозиторий — только имена.

# Ключ LLM-провайдера — нужен один, под выбранного в `hermes setup` / `hermes model`
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Telegram: токен от BotFather и числовые ID допущенных пользователей (не @username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# OpenAI-совместимый API шлюза — если к судье ходит наш сервис
API_SERVER_ENABLED=false
API_SERVER_HOST=0.0.0.0          # внутри контейнера; на хосте порт всё равно привязан к 127.0.0.1
API_SERVER_KEY=                  # openssl rand -hex 32
